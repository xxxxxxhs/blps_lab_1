<?xml version="1.0" encoding="UTF-8"?>
<ironjacamar>
    <connection-definitions>
        <connection-definition
            class-name="ru.blps.lab_1.eis.OnlyOfficeManagedConnectionFactory"
            jndi-name="java:/eis/OnlyOfficeConnectionFactory"
            enabled="true"
            use-java-context="true"
            pool-name="OnlyOfficePool">

            <config-property name="WebdavBaseUrl">http://nginx/cloud/remote.php/dav/files/admin</config-property>
            <config-property name="User">admin</config-property>
            <config-property name="Password">admin</config-property>

            <pool>
                <min-pool-size>1</min-pool-size>
                <max-pool-size>10</max-pool-size>
            </pool>
        </connection-definition>
    </connection-definitions>
</ironjacamar>